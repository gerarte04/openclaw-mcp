# {{ ansible_managed }}
{% set env = {
  'TELEGRAM_API_ID': telegram_api_id,
  'TELEGRAM_API_HASH': telegram_api_hash,
  'TELEGRAM_SESSION_FILE': 'data/telegram.session',
  'REST_BASE_URL': 'http://rest-server:8000',
  'SPOTIFY_CLIENT_ID': spotify_client_id,
  'SPOTIFY_REDIRECT_URI': 'http://127.0.0.1:8888/callback',
  'SPOTIFY_AUTH_BIND_HOST': '127.0.0.1',
  'SPOTIFY_TOKEN_FILE': 'data/spotify/refresh-token.json',
  'LASTFM_API_KEY': lastfm_api_key,
  'TELEGRAM_BOT_TOKEN': telegram_bot_token,
  'TELEGRAM_BOT_DEFAULT_CHAT_ID': telegram_bot_default_chat_id,
  'REST_BIND_ADDRESS': rest_bind_address,
  'REST_PORT': rest_port,
  'MCP_BIND_ADDRESS': mcp_bind_address,
  'MCP_PORT': mcp_port,
  'TELEGRAM_BOT_ALLOW_ANY_CHAT': telegram_bot_allow_any_chat | bool | lower,
  'TELEGRAM_BOT_ALLOWED_CHAT_IDS': telegram_bot_allowed_chat_ids,
  'COMPOSE_PROFILES': 'public' if public_mcp | bool else '',
  'MCP_DOMAIN': mcp_domain if public_mcp | bool else '',
  'MCP_PUBLIC_URL': 'https://' ~ mcp_domain if public_mcp | bool else '',
  'MCP_OAUTH_PASSWORD': mcp_oauth_password if public_mcp | bool else '',
  'MCP_OAUTH_ALLOWED_REDIRECT_URIS': mcp_oauth_allowed_redirect_uris,
} | combine(app_extra_env) %}
{# Empty values are omitted so the application defaults apply. #}
{% for key, value in env.items() if value | string | length > 0 %}
{{ key }}={{ value }}
{% endfor %}
