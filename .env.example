TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_with_api_hash
TELEGRAM_SESSION_FILE=data/telegram.session
INTEREST_SMOOTHING_K=100
INTEREST_REACTION_WEIGHT=3
INTEREST_COMMENT_WEIGHT=6
INTEREST_SHARE_WEIGHT=10
INTEREST_DECAY_LAMBDA=0.002
REST_BASE_URL=http://rest-server:8000
REQUEST_TIMEOUT_SECONDS=120
TELEGRAM_CHANNEL_TIMEOUT_SECONDS=12
TELEGRAM_QUERY_TIMEOUT_SECONDS=75
SPOTIFY_CLIENT_ID=replace_with_spotify_client_id
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_AUTH_BIND_HOST=127.0.0.1
SPOTIFY_TOKEN_FILE=data/spotify/refresh-token.json
SPOTIFY_API_BASE_URL=https://api.spotify.com/v1
SPOTIFY_ACCOUNTS_BASE_URL=https://accounts.spotify.com
SPOTIFY_PLAYLIST_ITEM_CONCURRENCY=4
LASTFM_API_KEY=replace_with_lastfm_api_key
LASTFM_API_BASE_URL=https://ws.audioscrobbler.com/2.0/
LASTFM_CACHE_TTL_SECONDS=3600
LASTFM_MAX_CONCURRENCY=6
LASTFM_REQUESTS_PER_SECOND=4
TELEGRAM_BOT_TOKEN=replace_with_bot_token_from_botfather
TELEGRAM_BOT_DEFAULT_CHAT_ID=
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org
# Host addresses and ports Docker Compose publishes the services on.
# 127.0.0.1 keeps them local; 0.0.0.0 listens on every network interface.
REST_BIND_ADDRESS=127.0.0.1
REST_PORT=8000
MCP_BIND_ADDRESS=127.0.0.1
MCP_PORT=8001
